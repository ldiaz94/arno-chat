// Deploy with `npx wrangler deploy`. Secrets are kept by Cloudflare across
// deploys and never live here (see OPERATIONS.md).
{
  "name": "arno-compat-probe",
  "main": "worker.js",
  "compatibility_date": "2026-10-30",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "vars": { "ALLOWED_GITHUB_LOGINS": "ldiaz94" },
  "durable_objects": { "bindings": [{ "name": "PROBE", "class_name": "ArnoProbe" }] },
  "exports": { "ArnoProbe": { "type": "durable-object", "storage": "sqlite" } },
  "containers": [
    {
      "name": "arno-compat-probe",
      "class_name": "ArnoProbe",
      "scheduling_policy": "durable_object",
      "images": {
        "runner": {
          "image": "registry.cloudflare.com/8186b19f2173607e1dc594e4dd579aed/arno-runner@sha256:b4f4e660255670a6e19d0f79b113adcddb6a7248faaad78545d021d38de74fba",
        },
      },
    },
  ],
  // The page, its script and styles, and brand images, served as they are.
  "assets": { "directory": "web" },
  "observability": { "enabled": true, "head_sampling_rate": 1, "traces": { "enabled": true } },
  "limits": { "cpu_ms": 100 },
}

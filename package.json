{
  "name": "arno-chat",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "eslint . && prettier --check . && node --import ./test-hooks.mjs --test test.mjs",
    "fmt": "prettier --write .",
    "deploy": "wrangler deploy --var BUILD:$(git rev-parse --short HEAD)$(git diff --quiet HEAD || echo +) --var DEPLOYED:$(date -u +%Y-%m-%dT%H:%MZ)"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "playwright": "^1.65.0",
    "prettier": "^3.9.10",
    "wrangler": "^4.158.0"
  }
}

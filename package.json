{
  "name": "arno-chat",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "eslint . && prettier --check . && node --import ./test/hooks.mjs --test test/test.mjs",
    "fmt": "prettier --write .",
    "deploy": "wrangler deploy --var BUILD:$(git rev-parse --short HEAD)$(git diff --quiet HEAD || echo +) --var DEPLOYED:$(date -u +%Y-%m-%dT%H:%MZ)",
    "test:serve": "node test/serve-test.mjs",
    "test:design": "node test/design-test.cjs",
    "test:offline": "node test/offline-test.cjs",
    "test:live": "node test/browser-test.cjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "playwright": "^1.65.0",
    "prettier": "^3.9.10",
    "wrangler": "^4.158.0"
  }
}
